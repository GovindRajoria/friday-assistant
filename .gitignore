# Virtual environment (1.1 GB, contains binaries far over GitHub's file limit)
friday_env/
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Model weights and exported artifacts - regenerate with openvino_yolo11_opt.py
*.pt
*.onnx
FRIDAY_CORE/yolo11n_openvino_model/

# Local runtime state and personal data
FRIDAY_CORE/config/settings.yaml
# The operator's own biography, injected into the system prompt. Personal
# by definition and this repository is public — it never gets committed.
FRIDAY_CORE/config/about_me.md
# Reminder bodies are whatever the operator asked to be reminded of,
# which is personal, and this repository is public.
FRIDAY_CORE/config/reminders.json
# The task list and the journal, for exactly the same reason: a to-do list is a
# list of things someone has not done yet, and a journal is a diary.
FRIDAY_CORE/config/tasks.json
FRIDAY_CORE/config/journal.json
FRIDAY_CORE/memory.db
*.db
FRIDAY_CORE/test_results.log
*.log
FRIDAY_CORE/fleet_market_ledger.csv

# Debug scratch output
FRIDAY_CORE/scratch/

# Desktop shell build artefacts. node_modules carries the Electron binary,
# roughly 300 MB of platform-specific files that npm install regenerates.
node_modules/
desktop/dist/
desktop/out/
desktop/.vite/
desktop/release/

# Generated documents
FRIDAY_Draft_*.docx

# Personal documents and local tooling directives
*.pdf
claude.md
CLAUDE.md

# Sample/benchmark media
FRIDAY_CORE/bus.jpg

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
